@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

:root {
  --bg-dark: #0b141a;
  --bg-panel: #111b21;
  --card: #202c33;
  --card-light: #2a3942;
  --chat-bg: #0e1a22;
  --incoming: #202c33;
  --outgoing: #005c4b;
  --text: #e9edef;
  --muted: #aebac1;
  --line: rgba(255, 255, 255, 0.08);
  --primary: #25d366;
  --danger: #ff5a5f;
  --shadow: rgba(0, 0, 0, 0.24);
}

* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  min-height: 100%;
  font-family: 'Inter', sans-serif;
  background: linear-gradient(180deg, #0b141a 0%, #101d24 100%);
  color: var(--text);
}

body {
  min-height: 100vh;
  display: grid;
  place-items: center;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

#app {
  width: min(1400px, 96vw);
  height: min(92vh, 840px);
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 20px 60px var(--shadow);
  background: var(--bg-panel);
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.auth-shell {
  display: grid;
  place-items: center;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(11,20,26,0.95), rgba(15,23,33,1));
}

.auth-card {
  width: min(440px, 92vw);
  background: rgba(32, 44, 51, 0.96);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20px;
  padding: 28px 22px 20px;
  box-shadow: 0 16px 36px rgba(0, 0, 0, 0.3);
}

.auth-header {
  text-align: center;
  margin-bottom: 26px;
}

.brand-badge {
  width: 68px;
  height: 68px;
  border-radius: 18px;
  background: linear-gradient(135deg, #25d366, #0ea5e9);
  color: #0b141a;
  display: grid;
  place-items: center;
  margin: 0 auto 14px;
  font-size: 2rem;
  font-weight: 700;
}

.auth-header h1 {
  margin: 0;
  font-size: clamp(1.6rem, 2vw, 2rem);
}

.auth-header p {
  margin: 8px 0 0;
  color: var(--muted);
}

.auth-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 18px;
}

.tab {
  border: 1px solid var(--line);
  background: transparent;
  color: var(--text);
  padding: 10px 14px;
  border-radius: 12px;
  transition: 0.2s ease;
}

.tab.active {
  background: var(--primary);
  color: #082f1d;
  border-color: transparent;
  font-weight: 700;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.field label {
  font-size: 0.86rem;
  color: var(--muted);
}

.field input {
  border: 1px solid var(--line);
  background: rgba(17, 27, 33, 0.75);
  color: var(--text);
  border-radius: 12px;
  padding: 12px 14px;
  outline: none;
}

.field input:focus {
  border-color: rgba(37, 211, 102, 0.7);
  box-shadow: 0 0 0 3px rgba(37, 211, 102, 0.12);
}

.primary-btn {
  margin-top: 10px;
  border: none;
  background: linear-gradient(135deg, #25d366, #7ae9a0);
  color: #092a1d;
  font-weight: 700;
  border-radius: 12px;
  padding: 12px 16px;
}

.hidden {
  display: none;
}

.auth-message {
  min-height: 22px;
  margin-top: 16px;
  color: #b8f6d2;
  font-size: 0.9rem;
}

.auth-message.error {
  color: #ffc7ca;
}

.app-shell {
  display: flex;
  width: 100%;
  height: 100%;
  background: var(--bg-panel);
}

.sidebar {
  width: 34%;
  min-width: 310px;
  background: #111b21;
  border-right: 1px solid var(--line);
  display: flex;
  flex-direction: column;
}

.sidebar-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 18px;
  background: var(--card);
  height: 74px;
}

.profile-pill {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: linear-gradient(135deg, #c9d1d7, #6b7280);
  display: grid;
  place-items: center;
  color: #111b21;
  font-weight: 700;
}

.top-actions {
  display: flex;
  gap: 12px;
}

.icon-btn {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: none;
  background: transparent;
  color: var(--muted);
  font-size: 1.15rem;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 10px 14px 8px;
  background: var(--card);
  border-radius: 12px;
  padding: 10px 12px;
  color: var(--muted);
}

.search-box input {
  background: transparent;
  border: none;
  outline: none;
  color: var(--text);
  width: 100%;
}

.user-list {
  overflow-y: auto;
  flex: 1;
}

.user-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  background: transparent;
  border: none;
  color: var(--text);
  text-align: left;
  border-bottom: 1px solid rgba(255, 255, 255, 0.03);
}

.user-item:hover,
.user-item.selected {
  background: rgba(255, 255, 255, 0.04);
}

.avatar {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: linear-gradient(135deg, #0ea5e9, #2563eb);
  display: grid;
  place-items: center;
  font-weight: 700;
  flex-shrink: 0;
}

.avatar-small {
  width: 42px;
  height: 42px;
  font-size: 0.9rem;
}

.user-text {
  min-width: 0;
  flex: 1;
}

.user-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4px;
}

.user-name {
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.user-time {
  color: var(--muted);
  font-size: 0.74rem;
}

.last-message {
  color: var(--muted);
  font-size: 0.82rem;
}

.empty-state {
  padding: 22px 16px;
  color: var(--muted);
}

.chat-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: var(--chat-bg);
  position: relative;
}

.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card);
  height: 74px;
  padding: 0 18px;
  border-bottom: 1px solid var(--line);
}

.chat-user {
  display: flex;
  align-items: center;
  gap: 12px;
}

.chat-name {
  font-weight: 700;
}

.chat-state {
  color: var(--muted);
  font-size: 0.76rem;
}

.chat-actions {
  display: flex;
  gap: 10px;
}

.messages {
  flex: 1;
  overflow-y: auto;
  padding: 18px 18px 12px;
  background-image:
    linear-gradient(rgba(11, 20, 26, 0.55), rgba(11, 20, 26, 0.55)),
    url('https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1200&q=80');
  background-size: cover;
  background-position: center;
}

.message-row {
  display: flex;
  margin-bottom: 10px;
}

.message-row.outgoing {
  justify-content: flex-end;
}

.message-row.incoming {
  justify-content: flex-start;
}

.message-bubble {
  max-width: 70%;
  border-radius: 12px;
  padding: 10px 12px 8px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  line-height: 1.4;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
}

.message-row.incoming .message-bubble {
  background: var(--incoming);
  border-top-left-radius: 2px;
}

.message-row.outgoing .message-bubble {
  background: var(--outgoing);
  border-top-right-radius: 2px;
}

.message-bubble small {
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.68rem;
  align-self: flex-end;
}

.composer {
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--card);
  padding: 10px 18px 14px;
  border-top: 1px solid var(--line);
}

.composer input {
  flex: 1;
  background: rgba(17, 27, 33, 0.92);
  border: 1px solid var(--line);
  color: var(--text);
  border-radius: 999px;
  padding: 12px 16px;
  outline: none;
}

.send-btn {
  width: 46px;
  height: 46px;
  border: none;
  border-radius: 50%;
  background: var(--primary);
  color: #0b141a;
  font-size: 1.2rem;
  font-weight: 700;
}

.empty-chat {
  flex: 1;
  display: grid;
  place-items: center;
  color: var(--muted);
  font-size: 1.05rem;
}

@media (max-width: 860px) {
  #app {
    width: 100vw;
    height: 100vh;
    border-radius: 0;
  }

  .app-shell {
    min-height: 100vh;
  }

  .sidebar {
    width: 42%;
    min-width: 220px;
  }
}

@media (max-width: 620px) {
  .app-shell {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    min-width: auto;
    border-right: none;
    border-bottom: 1px solid var(--line);
    height: 42%;
  }

  .chat-panel {
    height: 58%;
  }
}
